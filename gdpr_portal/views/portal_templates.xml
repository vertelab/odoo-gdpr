<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Portal page: what we hold, consents, export -->
        <template id="portal_gdpr" name="My Privacy">
            <t t-call="portal.portal_layout">
                <t t-set="o_portal_fullwidth_alert" groups="base.group_portal"/>
                <div class="row mt-3">
                    <div class="col-lg-8">
                        <h3 class="mb-3">My privacy</h3>

                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">What we hold about you</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted">
                                    We searched our records for
                                    <strong t-out="partner.name"/>
                                    <t t-if="partner.email">
                                        (<span t-out="partner.email"/>)
                                    </t>.
                                </p>
                                <t t-if="holdings">
                                    <p>
                                        Your data is held in
                                        <strong t-out="holding_count"/>
                                        records across the following areas:
                                    </p>
                                    <ul class="list-group list-group-flush">
                                        <li t-foreach="holdings" t-as="holding"
                                            class="list-group-item d-flex justify-content-between align-items-center">
                                            <span t-out="holding[0]"/>
                                            <span class="badge bg-secondary"
                                                  t-out="holding[1]"/>
                                        </li>
                                    </ul>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">
                                        We found no records holding your personal data.
                                    </p>
                                </t>
                                <div class="mt-3">
                                    <a href="/my/gdpr/export"
                                       class="btn btn-primary">
                                        Download my data
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Your consents</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="consents">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Consent</th>
                                                <th>Given</th>
                                                <th>State</th>
                                                <th/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="consents" t-as="consent">
                                                <td t-out="consent.name"/>
                                                <td t-out="consent.date"/>
                                                <td t-out="consent.state"/>
                                                <td class="text-end">
                                                    <t t-if="consent.state != 'withdrawn'">
                                                        <form method="post"
                                                              t-attf-action="/my/gdpr/consent/#{consent.id}/withdraw">
                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-danger">
                                                                Withdraw
                                                            </button>
                                                        </form>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">
                                        You have no recorded consents.
                                    </p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Entry in the portal home menu -->
        <template id="portal_my_home_gdpr" name="Portal: My Privacy"
                  inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-set="gdpr_count" t-value="1"/>
                <a class="o_portal_docs_link" href="/my/gdpr">
                    <i class="fa fa-shield me-1"/>
                    My privacy
                </a>
            </xpath>
        </template>

    </data>
</odoo>
