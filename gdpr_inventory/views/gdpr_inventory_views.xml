<odoo>
    <record id="view_gdpr_inventory_form" model="ir.ui.view">
        <field name="name">gdpr.inventory.form</field>
        <field name="model">gdpr.inventory</field>
        <field name="arch" type="xml">
            <form string="GDPR Inventory">
                <header>
                    <button type="object" name="update_object_ids" string="Update Objects"/>
                    <button type="object" name="restrict_objects" string="Restrict Objects" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" options="{'clickable': 1, 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_right oe_button_box" name="buttons">

                        <button class="oe_inline oe_stat_button" name="%(act_gdpr_inventory_2_gdpr_consent)d" type="action" icon="fa-files-o" invisible="not consent">
                            <field string="Consents" name="consent_count" widget="statinfo"/>
                        </button>

                        <button class="oe_inline oe_stat_button" name="%(act_gdpr_inventory_2_gdpr_object)d" type="action" icon="fa-files-o">
                            <field string="Objects" name="object_count" widget="statinfo"/>
                        </button>

                        <button class="oe_inline oe_stat_button" name="action_view_manual_objects" help="foobar gazonk" type="object" icon="fa-files-o" invisible="restrict_type != 'manual'">
                            <field string="Action Req." name="manual_count" widget="statinfo"/>
                        </button>

                        <button class="oe_inline oe_stat_button" name="action_view_objects" type="object" icon="fa-files-o">
                            <field string="Objects" name="object_count" widget="statinfo"/>
                        </button>

                        <button class="oe_inline oe_stat_button" name="act_gdpr_inventory_2_gdpr_res_partner" type="object" icon="fa-users">
                            <field string="Partners" name="partner_count" widget="statinfo"/>
                        </button>

                        <button class="oe_inline oe_stat_button" name="action_view_logs" type="object" icon="fa-archive">
                            <field string="Logs" name="log_count" widget="statinfo"/>
                        </button>

                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Describe the item..."/>
                        </h1>
                    </div>
                    <group col="4">
                        <field name="type_of_personal_data"/>
                        <field name="role"/>
                        <field name="user_id"/>
                        <field name="security_of_processing_ids" widget="many2many_tags"/>
                        <field name="category"/>
                        <field name="business_process"/>
                    </group>
                    <notebook>
                        <page string="Purpose">
                            <separator string="Purpose"/>
                            <field name="purpose_limitation" placeholder="Purpose Limitation"/>
                            <separator string="Lawsection"/>
                            <field name="lawsection_desc" placeholder="Lawsection description"/>
                            <group>
                                <field name="lawsection_id"/>
                                <field name="lawsection_description"/>
                                <field name="consent" invisible="1"/>
                            </group>
                        </page>
                        <page string="Data Description">
                            <group>
                                <field name="data_subject_ids" widget="many2many_tags"/>
                                <field name="data_type_ids" widget="many2many_tags"/>
                                <field name="data_collection_ids" widget="many2many_tags"/>
                                <field name="data_storage_ids" widget="many2many_tags"/>
                                <field name="data_sharing_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Identification">
                            <label for="identification_desc"/>
                            <field name="identification_desc"/>
                            <group>
                                <field name="data_local"/>
                            </group>
                            <group invisible="not data_local">
                                <field name="inventory_model"/>
                                <field name="inventory_domain"/>
                                <field name="partner_fields_ids" groups="gdpr_inventory.group_gdpr_officer" widget="many2many_tags" domain="[('model_id', '=', inventory_model)]"/>
                            </group>
                        </page>
                        <page string="Restrictions">
                            <group>
                                <!-- <field name="restrict_time_days"/> -->
                                <field name="restrict_scheduled_time"/>
                                <field name="restrict_method_id"/>
                                <field name="restrict_type" invisible="1"/>
                            </group>
                            <group invisible="not data_local">

                                <field name="restrict_domain"/>
                                <field name="pseudo_values" invisible="restrict_type != 'pseudo'"/>
                                <field name="restrict_code" invisible="restrict_type != 'code'"/>
                                <field name="fields_ids" groups="gdpr_inventory.group_gdpr_officer" widget="many2many_tags" domain="[('model_id', '=', inventory_model)]"/>
                            </group>
                        </page>
                        <page string="Consent" invisible="not consent">
                            <group>
                                <field name="consent_title"/>
                                <field name="consent_desc"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gdpr_inventory_tree" model="ir.ui.view">
        <field name="name">gdpr.inventory.tree</field>
        <field name="model">gdpr.inventory</field>
        <field name="arch" type="xml">
            <list string="GDPR Inventory">
                <field name="name"/>
                <field name="type_of_personal_data"/>
                <field name="user_id"/>
                <field name="lawsection_id"/>
                <field name="restrict_method_id"/>
                <field name="restrict_scheduled_time"/>
                <!-- <field name="restrict_time_days"/> -->
                <field name="security_of_processing_ids"/>
                <field name="state"/>
                <!-- <field name="state_id"/> -->
            </list>
        </field>
    </record>

    <record id="view_gdpr_inventory_kanban" model="ir.ui.view">
        <field name="name">gdpr.inventory.kanban</field>
        <field name="model">gdpr.inventory</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey" default_group_by="state">
                <field name="name"/>
                <field name="color"/>
                <field name="type_of_personal_data"/>
                <field name="purpose_limitation"/>
                <field name="user_id"/>
                <field name="lawsection_id"/>
                <field name="lawsection_desc"/>
                <field name="consent"/>
                <field name="consent_title"/>
                <field name="consent_desc"/>
                <field name="consent_count"/>
                <field name="restrict_method_id"/>
                <field name="inventory_model"/>
                <field name="inventory_domain"/>
                <field name="security_of_processing_ids"/>
                <field name="partner_count"/>
                <field name="object_count"/>
                <templates>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="set_cover" class="dropdown-item" data-field="displayed_image_id">Set Cover Image</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-1 ms-1">
                            <div class="min-w-0 pb-4 me-2">
                                <span class="text-truncate d-block fs-4 fw-bold" t-att-title="record.name.value">
                                    <field name="name"/>
                                </span>
                                <a>
                                    <div>
                                        <span>Objects </span>
                                        <field name="object_count" class="fw-bolder fs-5"/>
                                    </div>
                                </a>
                                <a>
                                    <div>
                                        <span>Partners </span>
                                        <field name="partner_count" class="fw-bolder fs-5"/>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gdpr_inventory_filter" model="ir.ui.view">
        <field name="name">gdpr.inventory.filter</field>
        <field name="model">gdpr.inventory</field>
        <field name="arch" type="xml">
            <search string="Search GDPR Inventory">
                <!-- <field name="state_id"/> -->
                <field name="user_id"/>
                <field name="lawsection_id"/>
                <separator/>
                <!-- <filter string="Draft" name="state_id" domain="[('state_id', '=', inventory_state_draft)]"/>
                    <filter string="Not Ceased" name="state_id" domain="[('state_id', '!=', inventory_state_ceased)]"/> -->
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Active" name="active" domain="[('state', '=', 'active')]" />
                <filter string="Restricted" name="restricted" domain="[('state', '=', 'restricted')]" />
                <filter string="General" name="type" domain="[('type_of_personal_data', '=', 'general')]"/>
                <filter string="Special" name="type" domain="[('type_of_personal_data', '=', 'special')]"/>
                <filter string="Data is local" name="type" domain="[('data_local', '=', True)]"/>
                <filter string="Data is not local" name="type" domain="[('data_local', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <!-- <filter name="group_by_state" string="State" domain="[]" context="{'group_by': 'state_id'}"/> -->
                    <filter name="group_by_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_by_responsible_user" string="Responsible" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_category" string="Category" domain="[]" context="{'group_by': 'category'}"/>
                    <filter name="group_by_business_process" string="Business Process" domain="[]" context="{'group_by': 'business_process'}"/>
                    <filter name="group_by_role" string="Role" domain="[]" context="{'group_by': 'role'}"/>
                    <filter name="group_by_lawsection" string="Lawsection" domain="[]" context="{'group_by': 'lawsection_id'}"/>
                    <filter name="group_by_parent" string="Parent" domain="[]" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_by_restrict_method" string="Restrict Method" domain="[]" context="{'group_by': 'restrict_method_id'}"/>
                    <filter name="group_by_type" string="Type" domain="[]" context="{'group_by': 'type_of_personal_data'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gdpr_inventory" model="ir.actions.act_window">
        <field name="name">GDPR Inventory</field>
        <field name="res_model">gdpr.inventory</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_gdpr_inventory_filter"/>
    </record>

    <!-- GDPR Inventory State -->
    <record id="view_gdpr_inventory_state_form" model="ir.ui.view">
        <field name="name">gdpr.inventory.state.form</field>
        <field name="model">gdpr.inventory.state</field>
        <field name="arch" type="xml">
            <form string="GDPR Inventory State">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_gdpr_inventory_state_tree" model="ir.ui.view">
        <field name="name">gdpr.inventory.state.tree</field>
        <field name="model">gdpr.inventory.state</field>
        <field name="arch" type="xml">
            <list string="GDPR Inventory State">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_gdpr_inventory_state_filter" model="ir.ui.view">
        <field name="name">gdpr.inventory.state.filter</field>
        <field name="model">gdpr.inventory.state</field>
        <field name="arch" type="xml">
            <search string="Search GDPR Inventory State">
                <field name="name" string="Name"/>
            </search>
        </field>
    </record>

    <record id="action_gdpr_inventory_state" model="ir.actions.act_window">
        <field name="name">GDPR Inventory State</field>
        <field name="res_model">gdpr.inventory.state</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gdpr_inventory_state_filter"/>
    </record>

</odoo>